# Settings of THIS organization that a real one would not copy (meta decisions.md, 2026-11-13).
#
# One maintainer: GitHub never lets an author approve their own pull request, so the code-owner
# review is not required (pull request, signed commits, required checks and resolved threads still
# are), and nobody needs to bypass the ruleset. A real organization leaves both at their defaults:
# every change approved by a code owner other than its author, no admin bypass.
solo_maintainer      = true
ruleset_admin_bypass = false
